<body>

    <!-- בר ראשי -->
    <nav class="navbar" style="background-color:rgb(0, 83, 80);">
        <div class="container-fluid d-flex align-items-center justify-content-between flex-nowrap ms-4">

            <!--  משתמש -->
            <div class="text-white d-flex align-items-center gap-2 ms-4">
                <span>user name</span>
                <button style="border:none; background:transparent; color:white;">
                    <i class="bi bi-person-circle fs-4"></i>
                </button>
                <!-- עגלה -->
                <button type="button" class="btn btn-success ms-5"><i class="bi bi-cart4"></i> Cart</button>

            </div>


            <!-- חיפוש באמצע -->
            <form class="d-flex justify-content-center ms-5" role="search" style="width:350px;">
                <input class="form-control rounded-pill me-2" type="search" placeholder="חיפוש מוצר"
                    aria-label="Search" />
                <button class="btn btn-success rounded-pill px-4" type="submit">Search</button>
            </form>

            <!--  - לוגו + שם חנות -->
            <div class="d-flex align-items-center gap-2 me-5" style="position: relative; right: 20px;">
                <span class="navbar-brand mb-0 fw-bold fs-4 text-white">
                    איילת השדה
                </span>
                <img src="image/logo.png" class="rounded-circle border border-white border-1"
                    style="width:50px; height:50px; object-fit:cover;">
            </div>

        </div>
        <!--בר משנה-->
    </nav>
    <nav class="navbar navbar-expand-lg bg-light border-top border-bottom sticky-top">
        <div class="container justify-content-center ">

